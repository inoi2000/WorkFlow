<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="journey"
            type="com.petproject.workflow.domain.entities.Journey" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardJourneyItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="6dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp"
        app:strokeColor="@color/grey_light"
        app:strokeWidth="0.5dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/containerMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:id="@+id/textDay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/main_blue"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/chipStatus"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="СЕГОДНЯ" />

            <TextView
                android:id="@+id/textDateTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/chipStatus"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textDay"
                tools:text="14:30 • 12 дек" />

            <!-- Status Chip -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chipStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textColor="@color/white"
                app:chipStrokeColor="@color/white"
                app:chipStrokeWidth="1dp"
                app:chipCornerRadius="20dp"
                app:chipMinTouchTargetSize="30dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/textDay"
                app:layout_constraintBottom_toBottomOf="@+id/textDateTime"
                tools:backgroundTint="@color/green"
                tools:text="ПОДТВЕРЖДЕН" />

            <!-- Address section -->
            <ImageView
                android:id="@+id/iconLocation"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_location"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/textAddress"
                app:layout_constraintBottom_toBottomOf="@+id/textAddress"
                app:tint="@color/main_blue"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/textAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="2sp"
                android:maxLines="2"
                android:text="@{journey.statement.destinationAddress}"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iconLocation"
                app:layout_constraintTop_toBottomOf="@+id/textDateTime"
                tools:text="г. Москва, ул. Примерная, д. 123, бизнес-центр 'Парус'" />

            <!-- Contact - Row 1 Col 1 -->
            <ImageView
                android:id="@+id/iconPhone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="14dp"
                android:src="@drawable/ic_phone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textAddress"
                app:tint="@color/grey_for_text"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/textPhone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/grey_for_text"
                android:textSize="12sp"
                app:layout_constraintEnd_toStartOf="@+id/guideline_center"
                app:layout_constraintStart_toEndOf="@+id/iconPhone"
                app:layout_constraintTop_toTopOf="@+id/iconPhone"
                tools:text="+7 999 123-45-67" />

            <!-- Car - Row 1 Col 2 -->
            <ImageView
                android:id="@+id/iconCar"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="14dp"
                android:src="@drawable/ic_car"
                app:layout_constraintStart_toEndOf="@+id/guideline_center"
                app:layout_constraintTop_toBottomOf="@+id/textAddress"
                app:tint="@color/grey_for_text"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/textCarLicense"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@{journey.car.licensePlate}"
                android:textColor="@color/grey_for_text"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iconCar"
                app:layout_constraintTop_toTopOf="@+id/iconCar"
                tools:text="A123BC777" />

            <!-- Logistician - Row 2 Col 1 -->
            <ImageView
                android:id="@+id/iconPerson"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="8dp"
                android:src="@drawable/ic_person"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iconPhone"
                app:tint="@color/grey_for_text"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/textLogistName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@{journey.statement.logist.name}"
                android:textColor="@color/grey_for_text"
                android:textSize="12sp"
                app:layout_constraintEnd_toStartOf="@+id/guideline_center"
                app:layout_constraintStart_toEndOf="@+id/iconPerson"
                app:layout_constraintTop_toTopOf="@+id/iconPerson"
                tools:text="Иванов А.С." />

            <!-- Trailer - Row 2 Col 2 -->
            <ImageView
                android:id="@+id/iconTrailer"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:src="@drawable/ic_trailer"
                app:layout_constraintStart_toEndOf="@+id/guideline_center"
                app:layout_constraintTop_toBottomOf="@+id/iconCar"
                app:tint="@color/main_blue"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/textTrailerLicense"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@{journey.trailer.licensePlate}"
                android:textColor="@color/main_blue"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iconTrailer"
                app:layout_constraintTop_toTopOf="@+id/iconTrailer"
                tools:text="П123ТР777" />

            <!-- Guideline for grid columns -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline_center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.5" />

            <!-- Bottom action row -->
            <TextView
                android:id="@+id/textAdditionalInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textColor="@color/grey_for_text"
                android:textSize="11sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/buttonDetails"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iconPerson"
                app:layout_constraintVertical_bias="0.0"
                tools:text="Создано: 12.12.2023 10:30" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDetails"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:backgroundTint="@color/blue_button_transparent"
                android:text="@string/more"
                android:textColor="?attr/colorPrimary"
                android:textSize="11sp"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textEnd"
                app:iconPadding="5dp"
                app:iconSize="14dp"
                app:iconTint="?attr/colorPrimary"
                app:layout_constraintBottom_toBottomOf="@+id/textAdditionalInfo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/textAdditionalInfo" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>
</layout>